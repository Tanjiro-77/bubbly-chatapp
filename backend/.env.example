# Bubbly Backend Environment Configuration

# Server Port
PORT=3000

# MongoDB Connection String (e.g. mongodb+srv://<username>:<password>@cluster.mongodb.net/bubbly)
MONGO_URI=mongodb://localhost:27017/bubbly

# JWT Secret Key (generate a strong 64+ char random string)
JWT_SECRET=your_jwt_secret_key_here

# Agora RTC Service Configuration
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Allowed CORS Origins (comma-separated, e.g. https://bubbly-chatapp.vercel.app,http://localhost:3000)
ALLOWED_ORIGINS=*

# Optional DNS configuration (set true only if required in specialized environments)
SET_PUBLIC_DNS=false

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
