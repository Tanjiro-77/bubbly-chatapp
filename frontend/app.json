{
  "expo": {
    "name": "Bubbly",
    "slug": "frontend",
    "version": "3.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bubbly",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 5,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.VIBRATE"
      ],
      "package": "com.arnav5569.chat"
    },
    "ios": {
      "bundleIdentifier": "com.arnav5569.chat",
      "buildNumber": "5",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Bubbly needs access to your camera to take photos and record video for chats and stories.",
        "NSMicrophoneUsageDescription": "Bubbly needs access to your microphone to record voice messages and make audio/video calls.",
        "NSPhotoLibraryUsageDescription": "Bubbly needs access to your photos to send images, videos, and custom avatars.",
        "NSPhotoLibraryAddUsageDescription": "Bubbly needs access to save photos and media from chats to your photo library.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "fetch",
          "audio",
          "voip",
          "fetch",
          "audio",
          "voip",
          "fetch",
          "audio",
          "voip",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-audio",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "881b5abb-ca66-4fca-83e3-b616aa9f0862"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/881b5abb-ca66-4fca-83e3-b616aa9f0862"
    }
  }
}
